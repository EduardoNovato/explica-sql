---
import LangSwitch from '../components/LangSwitch.astro';
import ThemeSwitch from '../components/ThemeSwitch.astro';
import { author, languages, useTranslations, type Lang } from '../i18n/ui';
import Base from './Base.astro';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  paths?: Record<Lang, string>;
  /** Marca la sección actual en el encabezado */
  section?: 'rules' | 'oracle';
  noindex?: boolean;
}

const { lang, title, description, section, noindex } = Astro.props;
const t = useTranslations(lang);
const paths = Astro.props.paths ?? { es: languages.es.path, en: languages.en.path };
const portfolio = new URL(languages[lang].path, author.portfolio).href;
---

<Base lang={lang} title={title} description={description} paths={paths} noindex={noindex}>
  <a href="#main" class="skip-link">{t.skip}</a>

  <div class="mx-auto flex min-h-dvh max-w-6xl flex-col px-4 sm:px-6">
    <header class="flex items-center justify-between gap-3 border-b border-line py-3.5">
      <a href={languages[lang].path} aria-label={t.header.home} class="inline-flex shrink-0 items-center gap-2.5 rounded-md" translate="no">
        <svg class="size-7" viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="14" class="fill-surface-2"></rect>
          <g class="fill-accent">
            <rect x="13" y="16" width="38" height="8" rx="4"></rect>
            <rect x="21" y="28" width="24" height="8" rx="4" opacity="0.7"></rect>
            <rect x="21" y="40" width="13" height="8" rx="4" opacity="0.45"></rect>
          </g>
        </svg>
        <span class="hidden font-serif text-xl text-ink min-[400px]:inline">Explica SQL</span>
      </a>
      <div class="flex items-center gap-1 sm:gap-2">
        <a
          href={languages[lang].rulesPath}
          aria-current={section === 'rules' ? 'page' : undefined}
          class="rounded-lg px-2 py-2 text-sm text-muted transition-colors hover:text-ink aria-[current=page]:text-accent sm:px-2.5"
        >
          {t.header.rules}
        </a>
        <a
          href={languages[lang].oraclePath}
          aria-current={section === 'oracle' ? 'page' : undefined}
          class="rounded-lg px-2 py-2 text-sm text-muted transition-colors hover:text-ink aria-[current=page]:text-accent sm:px-2.5"
        >
          {t.header.oracle}
        </a>
        <LangSwitch lang={lang} paths={paths} />
        <ThemeSwitch lang={lang} />
      </div>
    </header>

    <main id="main" class="flex-1 pb-16 pt-12 sm:pt-16">
      <slot />
    </main>

    <footer class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line py-6 text-xs text-faint">
      <p>
        {`${t.footer.madeBy} `}<a
          href={portfolio}
          hreflang={languages[lang].locale}
          class="text-muted underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
          >{author.name}</a
        >{` ${t.footer.place}`}
      </p>
      <p class="font-mono">{t.footer.license}</p>
    </footer>
  </div>
</Base>
