---
import Base from '../layouts/Base.astro';
import LangSwitch from './LangSwitch.astro';
import PlanInput from './PlanInput.tsx';
import StepHeading from './StepHeading.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import UiIcon from './UiIcon.astro';
import { author, languages, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const portfolio = new URL(languages[lang].path, author.portfolio).href;
---

<Base lang={lang}>
  <a href="#main" class="skip-link">{t.skip}</a>

  <div class="mx-auto flex min-h-dvh max-w-3xl flex-col px-4 sm:px-6">
    <header class="flex items-center justify-between gap-4 border-b border-line py-3.5">
      <a href={languages[lang].path} aria-label={t.header.home} class="inline-flex items-center gap-2.5 rounded-md" translate="no">
        <svg class="size-7" viewBox="0 0 64 64" aria-hidden="true">
          <rect width="64" height="64" rx="14" class="fill-surface-2" />
          <g class="fill-accent">
            <rect x="13" y="16" width="38" height="8" rx="4" />
            <rect x="21" y="28" width="24" height="8" rx="4" opacity="0.7" />
            <rect x="21" y="40" width="13" height="8" rx="4" opacity="0.45" />
          </g>
        </svg>
        <span class="font-serif text-xl text-ink">Explica SQL</span>
      </a>
      <div class="flex items-center gap-1.5">
        <LangSwitch lang={lang} />
        <ThemeSwitch lang={lang} />
      </div>
    </header>

    <main id="main" class="flex-1 pb-16 pt-12 sm:pt-20">
      <section aria-labelledby="title">
        <p class="font-mono text-[13px] text-accent sm:text-sm" translate="no">
          <span aria-hidden="true">&gt; </span>{t.hero.eyebrow}<span class="caret" aria-hidden="true"></span>
        </p>
        <h1 id="title" translate="no" class="mt-5 font-serif text-[clamp(3.25rem,14vw,6rem)] leading-[0.95] tracking-[-0.015em] text-ink">
          Explica SQL
        </h1>
        <p class="mt-6 max-w-[44ch] text-lg leading-relaxed text-pretty text-muted sm:text-xl">{t.hero.tagline}</p>
      </section>

      <section class="mt-14 sm:mt-16" aria-labelledby="step-run">
        <StepHeading id="step-run" step={1}>{t.command.title}</StepHeading>
        <div class="theme-fade mt-4 overflow-hidden rounded-xl border border-line-strong bg-surface">
          <div class="flex items-center gap-1.5 border-b border-line px-3.5 py-2">
            <span class="size-2.5 rounded-full border border-ill" aria-hidden="true"></span>
            <span class="size-2.5 rounded-full border border-ill" aria-hidden="true"></span>
            <span class="size-2.5 rounded-full bg-accent" aria-hidden="true"></span>
            <span class="ml-2.5 font-mono text-[11px] text-faint" aria-hidden="true" translate="no">psql · DBeaver · pgAdmin</span>
            <button
              type="button"
              data-copy={'EXPLAIN (ANALYZE, BUFFERS)\n'}
              data-status="copy-status"
              data-ok={t.command.copied}
              data-error={t.command.copyError}
              class="group -mr-1.5 ml-auto inline-flex items-center gap-1.5 rounded-md px-2 py-1.5 font-mono text-[11px] text-muted transition-colors hover:bg-surface-2 hover:text-accent"
            >
              <UiIcon name="copy" class="size-3.5 group-data-[state=copied]:hidden" />
              <UiIcon name="check" class="hidden size-3.5 text-accent group-data-[state=copied]:block" />
              <span aria-hidden="true">{t.command.copy}</span>
              <span class="sr-only">{t.command.copyLong}</span>
            </button>
          </div>
          <pre
            class="overflow-x-auto px-4 py-4 font-mono text-[13px] leading-[1.75] text-ink [font-variant-ligatures:none] sm:text-sm"
            translate="no"><code><span class="text-accent">EXPLAIN</span> (<span class="text-accent">ANALYZE</span>, <span class="text-accent">BUFFERS</span>)
<span class="text-accent">SELECT</span> <span class="text-faint">…</span></code></pre>
        </div>
        <p id="copy-status" class="sr-only" role="status" aria-live="polite"></p>
        <p class="mt-3 max-w-[68ch] text-sm leading-relaxed text-pretty text-muted">{t.command.hint}</p>
      </section>

      <section class="mt-12 sm:mt-14" aria-labelledby="step-paste">
        <StepHeading id="step-paste" step={2}>{t.input.title}</StepHeading>
        <p id="step-paste-hint" class="mt-2 text-sm leading-relaxed text-pretty text-muted">{t.input.hint}</p>
        <div class="mt-4">
          <PlanInput
            client:load
            strings={t.input}
            locale={languages[lang].locale}
            labelledBy="step-paste"
            describedBy="step-paste-hint"
          />
        </div>
        <p class="mt-3 flex items-start gap-2 text-sm leading-relaxed text-muted">
          <UiIcon name="lock" class="mt-[0.2em] size-4 shrink-0 text-accent" />
          {t.input.privacy}
        </p>
      </section>
    </main>

    <footer class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 border-t border-line py-6 text-xs text-faint">
      <p>
        {`${t.footer.madeBy} `}<a
          href={portfolio}
          hreflang={languages[lang].locale}
          class="text-muted underline decoration-line-strong underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
          >{author.name}</a
        >{` ${t.footer.place}`}
      </p>
      <p class="font-mono">{t.footer.license}</p>
    </footer>
  </div>
</Base>

<script>
  import '../scripts/copy.ts';
</script>
